# Token do @BotFather
TELEGRAM_TOKEN=
# O teu chat id (envia /id ao bot para o descobrir)
ALLOWED_CHAT_ID=
# Segundos entre ciclos (mínimo 60)
POLL_INTERVAL=120
DB_PATH=vintedbot.db
# Botão "Avaliar preço" nos alertas (usa o Claude CLI, se estiver instalado e com sessão iniciada)
# PRICE_CHECK=0 desliga; CLAUDE_BIN só é preciso se o claude não estiver no PATH
PRICE_CHECK=1
CLAUDE_BIN=
CLAUDE_MODEL=sonnet
